{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "source": "/Users/rajdeep/.config/fastfetch/cat.txt",
    "type": "auto",
    "padding": {
        "top": 1,
        "left": 1,
        "right": 2,
        "down": 0
    },

    "width": 18,
    "height": 8,

    "printRemaining": true,
    "preserveAspectRatio": true
  },

  "display": {
    "separator": " │ ",
    "disableLinewrap": true,
    "brightColor": true,

    "key": {
      "width": 10,
      "paddingLeft": 0
    },

    "bar": {
      "width": 12,

      "char": {
        "elapsed": "■",
        "total": " "
      },

      "border": {
        "left": "[",
        "right": "]"
      }
    },

    "percent": {
      "type": [
        "bar",
        "num"
      ],

      "green": 50,
      "yellow": 80
    }
  },

  "modules": [
    {
      "type": "title"
    },

    "break",

    {
      "type": "os",
      "key": "os"
    },

    {
      "type": "kernel",
      "key": "kernel"
    },

    {
      "type": "shell",
      "key": "shell"
    },

    {
      "type": "packages",
      "key": "pkgs",
      "disabled": [
        "flatpak"
      ]
    },

    "break",

    {
      "type": "wm",
      "key": "wm"
    },

    {
      "type": "theme",
      "key": "theme"
    },

    {
      "type": "terminal",
      "key": "term"
    },

    "break",

    {
      "type": "cpu",
      "key": "cpu",
      "format": "{name}"
    },

    {
      "type": "gpu",
      "key": "gpu",
      "format": "{name}"
    },

    {
      "type": "memory",
      "key": "mem"
    },

    {
      "type": "disk",
      "key": "disk",
      "folders": "/",
      "percent": {
        "type": [
          "bar",
          "num"
        ]
      }
    },

    {
      "type": "battery",
      "key": "bat",
      "temp": true
    },

    {
      "type": "uptime",
      "key": "up"
    },

    "break",

    {
      "type": "localip",
      "key": "ip",
      "showIpv6": false,
      "compact": true
    },
  ]
}
